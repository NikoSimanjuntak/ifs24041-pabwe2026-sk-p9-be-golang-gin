{
  "swagger": "2.0",
  "info": {
    "title": "Delcom Blog API",
    "description": "REST API platform blog multi-tier dengan AI Blog Generator terintegrasi Search Engine. Format respons: {status, message, data?}. Autentikasi: Authorization: Bearer <token>.",
    "version": "1.0"
  },
  "host": "localhost:8081",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Format: Bearer <token>"
    }
  },
  "paths": {
    "/api.json": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "Spesifikasi OpenAPI JSON",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Berhasil"
          },
          "400": {
            "description": "Permintaan tidak valid"
          },
          "401": {
            "description": "Tidak terautentikasi"
          },
          "404": {
            "description": "Tidak ditemukan"
          },
          "500": {
            "description": "Kesalahan server"
          }
        }
      }
    },
    "/api/public/categories": {
      "get": {
        "tags": [
